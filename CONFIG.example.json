{
  "server": {
    "host": "127.0.0.1",
    "port": 9010,
    "publicBaseUrl": "https://gateway.js.gripe/api/v1/donate"
  },
  "database": {
    "path": "/opt/donate-gateway/data/donate.sqlite3"
  },
  "orders": {
    "defaultExpiryMinutes": 30,
    "minimumAmount": "1.00",
