  },
  "assets": [
    {
      "asset": "USDT",
      "network": "TRC20",
      "enabled": true,
      "receiveAddress": "REPLACE_WITH_RECEIVE_ADDRESS",
      "addressPool": [
        "REPLACE_WITH_TRON_RECEIVE_ADDRESS_0001",
        "REPLACE_WITH_TRON_RECEIVE_ADDRESS_0002"
      ],
      "tokenContract": "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t",
      "confirmations": 1
    }
  ],
  "screening": {
    "provider": "local-ofac-exact",
    "localSanctionsPath": "/opt/donate-gateway/config/sanctions-addresses.txt"
  },
  "tron": {
    "enabled": true,
    "apiBaseUrl": "https://api.trongrid.io",
    "apiKey": "",
    "pollIntervalSeconds": 90,
    "transferLimit": 50
